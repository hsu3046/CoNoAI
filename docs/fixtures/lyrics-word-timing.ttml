<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xml:lang="ko">
  <body><div>
    <p begin="00:00:01.000" end="00:00:04.000"><span begin="00:00:01.000" end="00:00:02.000">오늘은 </span><span begin="00:00:02.000" end="00:00:03.000">나의 </span><span begin="00:00:03.000" end="00:00:04.000">무대</span></p>
    <p begin="00:00:05.000" end="00:00:08.000"><span begin="00:00:05.000" end="00:00:06.000">작은 </span><span begin="00:00:06.000" end="00:00:07.000">목소리로 </span><span begin="00:00:07.000" end="00:00:08.000">시작해</span></p>
    <p begin="00:00:09.000" end="00:00:12.000"><span begin="00:00:09.000" end="00:00:10.000">한 곡 </span><span begin="00:00:10.000" end="00:00:11.000">가득 </span><span begin="00:00:11.000" end="00:00:12.000">빛나게</span></p>
  </div></body>
</tt>
